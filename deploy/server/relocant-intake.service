[Unit]
Description=Relocant private submissions batch collector
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=relocant
Group=relocant
WorkingDirectory=/opt/relocant-media/app
EnvironmentFile=/etc/relocant-media.env
ExecStart=/opt/relocant-media/venv/bin/python -m relocant_media.ops.intake_batch
TimeoutStartSec=70min
MemoryMax=450M
CPUQuota=70%
Nice=10
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/relocant-media /var/log/relocant-media
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
