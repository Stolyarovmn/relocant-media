[Unit]
Description=Relocant editorial collection, review and guarded delivery
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=relocant
Group=relocant
WorkingDirectory=/opt/relocant-media/app
EnvironmentFile=/etc/relocant-media.env
ExecStartPre=/opt/relocant-media/app/deploy/server/check-main-sync.sh
ExecStart=/opt/relocant-media/app/deploy/server/run-cycle.sh
TimeoutStartSec=70min
MemoryMax=450M
CPUQuota=70%
Nice=10
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/relocant-media /var/log/relocant-media
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

