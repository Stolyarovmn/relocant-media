APP_ENV=staging
CITY_ID=belgrade
LOG_LEVEL=INFO

POSTGRES_DB=relocant
POSTGRES_USER=relocant
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://relocant:change-me@postgres:5432/relocant

# Telegram staging runtime stays inert until explicitly enabled after smoke checks.
TELEGRAM_RUNTIME_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_URL=https://example.invalid/telegram/webhook
TELEGRAM_STAGING_CHANNEL_ID=
TELEGRAM_STAGING_DISCUSSION_GROUP_ID=
TELEGRAM_STAGING_FORUM_GROUP_ID=

# Reserved production targets. Never point staging IDs at these resources.
TELEGRAM_CHANNEL_ID=
TELEGRAM_DISCUSSION_GROUP_ID=
TELEGRAM_FORUM_GROUP_ID=

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Optional engineering / second-opinion layer
ANTHROPIC_API_KEY=
