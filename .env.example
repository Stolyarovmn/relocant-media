APP_ENV=dev
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://relocant:relocant@postgres:5432/relocant

# Telegram staging runtime is inert until explicitly enabled.
TELEGRAM_RUNTIME_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_STAGING_CHANNEL_ID=
TELEGRAM_STAGING_DISCUSSION_GROUP_ID=
TELEGRAM_STAGING_FORUM_GROUP_ID=

# Reserved production targets. Staging code must not use these IDs.
TELEGRAM_CHANNEL_ID=
TELEGRAM_DISCUSSION_GROUP_ID=
TELEGRAM_FORUM_GROUP_ID=

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Optional engineering / second-opinion layer
ANTHROPIC_API_KEY=
